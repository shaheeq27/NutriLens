# NutriLens — environment variables
#
# Copy this file to .env and fill in real values for anything you need.
# Never commit the real .env file — see .gitignore.
#
# The variables below are a contract: backend/app/core/config.py (file #7)
# and the provider modules (files #14-16) will read these exact names.

# --- App environment ---
ENVIRONMENT=development

# When true, every provider (vision, OCR, nutrition lookup) returns a
# canned/mock response instead of calling a real external API — this is
# what lets the whole scan flow run locally with zero real API keys.
# See "Use mock providers before connecting real external APIs" in
# README.md.
USE_MOCK_PROVIDERS=true

# --- CORS ---
# Comma-separated list of origins allowed to call the backend API.
# Add the deployed Vercel frontend URL alongside localhost once it exists.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OpenAI (vision: raw-food identification, package-vs-raw detection) ---
OPENAI_API_KEY=

# --- Google Cloud Vision (OCR: packaged-food nutrition labels) ---
# Path to a service-account JSON key file. Never commit the key file
# itself — see .gitignore (service-account*.json, *.serviceaccount.json).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- USDA FoodData Central (raw-food nutrition values) ---
# Free key from https://fdc.nal.usda.gov/api-guide/
USDA_FOODDATA_API_KEY=

# --- Backend server (Cloud Run deployment) ---
# Cloud Run injects PORT automatically in production; this default is
# only used for local development.
PORT=8080

# --- Frontend (Next.js) ---
# Base URL of the backend API. Must be prefixed NEXT_PUBLIC_ to be
# readable in the browser, since scan requests are made client-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
